{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSRPG source-backed creature melee timing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attacks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "attacks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "variant", "model", "clip", "contactSeconds", "durationSeconds", "windupTicks", "recoveryTicks", "evidence"],
        "properties": {
          "entityType": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"},
          "variant": {"enum": ["default", "sword", "axe", "spear"]},
          "model": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "clip": {"type": "string", "pattern": "^attack(?:_[a-z0-9_]+)?$"},
          "contactSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
          "windupTicks": {"type": "integer", "minimum": 1, "maximum": 600},
          "recoveryTicks": {"type": "integer", "minimum": 1, "maximum": 600},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  },
  "$comment": "Runtime also requires durationSeconds > contactSeconds, unique entity/variant pairs, a model supplied for that entity, an existing nonempty attack clip, and the exact supplied clip duration. Contact times are curve-based interpretations, not author hit markers."
}
