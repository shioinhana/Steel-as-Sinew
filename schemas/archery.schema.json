{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSRPG legacy archery rules",
  "description": "Server ticks (20 per second); arrow speed in blocks/tick. Legacy shot and bash have no extra stamina/spirit cost by default. Version 0.5.3 scales existing rapid/snipe/bash stamina costs by 0.2 once; spirit costs are preserved. Fields store the actual server debit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rapidDrawTicks","snipeDrawTicks","rapidArrowSpeed","snipeArrowSpeed","minReleasePower","rapidScoreStep","rapidReductionPerStep","rapidReductionCap","snipeScoreStep","snipeSpeedPerStep","snipeSpeedCap","autoChargeScore","trajectoryScore","scopeScore","scopeMaxMagnification","ruSuoCharges","ruSuoReduction","totalDrawReductionCap","ruSuoRecoverTicks","nieShiCooldownTicks","yanXiaDianSpeedBonus","chuanTangFengArmorPierce","chuanTangFengBlockPierce","chuanTangFengBlockSlow","chuanTangFengEntityPierce","rapidDurability","snipeDurability","bashRange","bashDamage","bashKnockback","bashCooldownTicks","rapidStaminaCost","snipeStaminaCost","shotSpiritCost","bashStaminaCost","shotAnimationTicks","bashAnimationTicks"],
  "properties": {
    "rapidDrawTicks": {"type":"number","minimum":1,"maximum":12000},
    "snipeDrawTicks": {"type":"number","minimum":1,"maximum":12000},
    "rapidArrowSpeed": {"type":"number","minimum":0.01,"maximum":128},
    "snipeArrowSpeed": {"type":"number","minimum":0.01,"maximum":128},
    "minReleasePower": {"type":"number","minimum":0,"maximum":1},
    "rapidScoreStep": {"type":"integer","minimum":1,"maximum":1000000},
    "rapidReductionPerStep": {"type":"number","minimum":0,"maximum":1},
    "rapidReductionCap": {"type":"number","minimum":0,"maximum":0.99},
    "snipeScoreStep": {"type":"integer","minimum":1,"maximum":1000000},
    "snipeSpeedPerStep": {"type":"number","minimum":0,"maximum":100},
    "snipeSpeedCap": {"type":"number","minimum":0,"maximum":100},
    "autoChargeScore": {"type":"integer","minimum":0,"maximum":1000000},
    "trajectoryScore": {"type":"integer","minimum":0,"maximum":1000000},
    "scopeScore": {"type":"integer","minimum":0,"maximum":1000000},
    "scopeMaxMagnification": {"type":"number","minimum":1,"maximum":32},
    "ruSuoCharges": {"type":"integer","minimum":1,"maximum":128},
    "ruSuoReduction": {"type":"number","minimum":0,"maximum":0.99},
    "totalDrawReductionCap": {"type":"number","minimum":0,"maximum":0.99},
    "ruSuoRecoverTicks": {"type":"integer","minimum":1,"maximum":12000},
    "nieShiCooldownTicks": {"type":"integer","minimum":1,"maximum":12000},
    "yanXiaDianSpeedBonus": {"type":"number","minimum":0,"maximum":100},
    "chuanTangFengArmorPierce": {"type":"number","minimum":0,"maximum":10},
    "chuanTangFengBlockPierce": {"type":"integer","minimum":0,"maximum":32},
    "chuanTangFengBlockSlow": {"type":"number","minimum":0,"maximum":1},
    "chuanTangFengEntityPierce": {"type":"integer","minimum":0,"maximum":127},
    "rapidDurability": {"type":"integer","minimum":0,"maximum":1000},
    "snipeDurability": {"type":"integer","minimum":0,"maximum":1000},
    "bashRange": {"type":"number","minimum":0,"maximum":32},
    "bashDamage": {"type":"number","minimum":0,"maximum":1000000},
    "bashKnockback": {"type":"number","minimum":0,"maximum":16},
    "bashCooldownTicks": {"type":"integer","minimum":0,"maximum":12000},
    "rapidStaminaCost": {"type":"number","minimum":0,"maximum":1000000},
    "snipeStaminaCost": {"type":"number","minimum":0,"maximum":1000000},
    "shotSpiritCost": {"type":"number","minimum":0,"maximum":1000000},
    "bashStaminaCost": {"type":"number","minimum":0,"maximum":1000000},
    "shotAnimationTicks": {"type":"integer","minimum":1,"maximum":12000},
    "bashAnimationTicks": {"type":"integer","minimum":1,"maximum":12000},
    "partialShotStaminaMultiplier": {"type":"number","minimum":0,"maximum":1,"default":0.7,"description":"未拉满的有效射击固定消耗倍率，默认0.7；与实际蓄力比例无关，拉满恢复1.0倍率。"}
  }
}
