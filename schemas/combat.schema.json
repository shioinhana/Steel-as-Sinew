{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrpg.local/schemas/combat.schema.json",
  "title": "FSRPG 战斗基础参数",
  "description": "config/fsrpg/combat.json。时间均为每秒 20 tick。闪避无敌开始时间 + 无敌持续时间不得超过闪避总时长，此跨字段关系由服务端重载校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["maxStamina", "maxSpirit", "staminaRegenPerSecond", "spiritRegenPerSecond", "resourceRegenDelayTicks", "drawTicks", "sheathTicks", "guardArcDegrees", "guardDamageMultiplier", "guardStaminaCost", "perfectGuardTicks", "perfectGuardStaminaCost", "parryStunTicks", "guardBreakStunTicks", "hitStunTicks", "clashFacingArcDegrees", "dodgeDurationTicks", "dodgeInvulnerabilityStartTicks", "dodgeInvulnerabilityTicks", "dodgeCooldownTicks", "dodgeStaminaCost", "dodgeDistance", "dodgeCancelsRecovery", "allowAirDodge"],
  "properties": {
    "maxStamina": { "type": "number", "minimum": 1, "maximum": 1000000, "default": 50, "description": "0级基础体力上限，默认50。正等级x的实际上限为基础值+x^0.8+3ln(x)，保留小数；系数由staminaLevelScaling配置。" },
    "maxSpirit": { "type": "number", "minimum": 1, "maximum": 1000000 },
    "staminaRegenPerSecond": { "$ref": "#/$defs/resource", "default": 5, "description": "0级静止体力回复点数/秒，默认5。正等级x的静止回复为floor(基础值+sqrt(x)+ln(x))，仅回复向下取整；战斗时按staminaCombatRules.regenMultiplier缩放，不再暂停回复。" },
    "spiritRegenPerSecond": { "$ref": "#/$defs/resource" },
    "resourceRegenDelayTicks": { "$ref": "#/$defs/ticks", "description": "仅灵力在消耗后的回复延迟；体力使用staminaCombatRules。" },
    "staminaCombatRules": {
      "type": "object", "additionalProperties": false,
      "description": "体力两级回复。命中、格挡、被格挡、受击、弹反、拼刀和闪避开始近期战斗状态；已发出且未接触的攻击仅保留成本乘missCostMultiplier，其它返还，不触发或延长战斗状态。接受时预扣全额，按接受时的成本结算一次；前摇中断未发出保留原全额成本。",
      "required": ["combatTicks", "regenMultiplier", "missCostMultiplier"],
      "properties": {
        "combatTicks": { "$ref": "#/$defs/ticks", "default": 60, "description": "最后一次实际战斗行为后的持续时间，默认60tick=3秒。" },
        "regenMultiplier": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "missCostMultiplier": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
      }
    },
    "drawTicks": { "$ref": "#/$defs/ticks" },
    "sheathTicks": { "$ref": "#/$defs/ticks" },
    "guardArcDegrees": { "$ref": "#/$defs/angle" },
    "guardDamageMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
    "guardStaminaCost": { "$ref": "#/$defs/resource", "description": "服务端每次成功格挡的实际体力扣除。0.5.3 升级按原配置乘 0.2，仅迁移一次。" },
    "perfectGuardTicks": { "$ref": "#/$defs/ticks", "description": "普通来袭的启用完美格挡窗口，0.7.5默认6tick=0.3秒；提示攻击还须在guard_cues.json指定的[open,close)内重新按C，提示前按住不产生完美格挡。持续按住与轻重模式切换不刷新起点。时点为项目可调标定，不宣称未公开的原作帧数。0仍表示关闭。" },
    "perfectGuardStaminaCost": { "$ref": "#/$defs/resource", "description": "服务端每次成功完美格挡的实际体力扣除。" },
    "parryStunTicks": { "$ref": "#/$defs/ticks", "description": "被完美格挡的攻击者僵直时间，默认4tick=0.2秒；NPC同时停止实际AI与攻击。" },
    "guardBreakStunTicks": { "$ref": "#/$defs/ticks" },
    "hitStunTicks": { "$ref": "#/$defs/ticks" },
    "clashFacingArcDegrees": { "$ref": "#/$defs/angle" },
    "dodgeDurationTicks": { "type": "integer", "minimum": 1, "maximum": 72000 },
    "dodgeInvulnerabilityStartTicks": { "$ref": "#/$defs/ticks" },
    "dodgeInvulnerabilityTicks": { "$ref": "#/$defs/ticks" },
    "dodgeCooldownTicks": { "$ref": "#/$defs/ticks" },
    "dodgeStaminaCost": { "$ref": "#/$defs/resource", "description": "服务端接受闪避时的实际体力扣除，默认 6。" },
    "dodgeDistance": { "type": "number", "minimum": 0, "maximum": 32 },
    "dodgeCancelsRecovery": { "type": "boolean" },
    "allowAirDodge": { "type": "boolean" },
    "spearSwipeKnockbackMultiplier": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "description": "长枪持续刺出时划动接触的击退系数，乘以当前skill.knockback；服务端按真实划动方向处理切向推移或空中下划击坠。缺字段兼容0.5，0关闭划动击退，所有原攻击数值保留。" },
    "burstDash": {
      "type": "object", "additionalProperties": false,
      "description": "物理Shift新按一次触发独立的水平突进，不提供无敌、不取消已发出的攻击，也不重置垂直速度；支持接跳跃。开始后方向固定，按住沿此方向奔跑，松开仅停止后续奔跑。Shift+C优先重格挡。旧Alt闪避数值独立保留。",
      "required": ["distance", "durationTicks", "staminaCost", "cooldownTicks", "runSpeed", "inputLeaseTicks"],
      "properties": {
        "distance": { "type": "number", "minimum": 0.25, "maximum": 32, "default": 3.0 },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
        "staminaCost": { "$ref": "#/$defs/resource", "default": 5.0 },
        "cooldownTicks": { "$ref": "#/$defs/ticks", "default": 10 },
        "runSpeed": { "type": "number", "minimum": 0, "maximum": 12, "default": 5.6, "description": "格每秒，runSpeed*durationTicks/20 不得超过3*distance，保证加速曲线单调前进。" },
        "inputLeaseTicks": { "type": "integer", "minimum": 2, "maximum": 100, "default": 12 }
      }
    },
    "staminaLevelScaling": {
      "type": "object", "additionalProperties": false,
      "description": "x取服务端同步的原版经验等级experienceLevel（HUD Lv），必须非负；0级直接使用基础值，避免ln(0)。只对正等级回复的完整表达式向下取整，上限保留小数。升级不补体力，降级只截到新上限。缺省兼容默认系数。",
      "required": ["regenSqrtCoefficient", "regenLogCoefficient", "maxPowerCoefficient", "maxPowerExponent", "maxLogCoefficient"],
      "properties": {
        "regenSqrtCoefficient": { "$ref": "#/$defs/resource", "default": 1 },
        "regenLogCoefficient": { "$ref": "#/$defs/resource", "default": 1 },
        "maxPowerCoefficient": { "$ref": "#/$defs/resource", "default": 1 },
        "maxPowerExponent": { "type": "number", "minimum": 0, "maximum": 4, "default": 0.8 },
        "maxLogCoefficient": { "$ref": "#/$defs/resource", "default": 3 }
      }
    },
    "perfectGuardCounter": {
      "type": "object", "additionalProperties": false,
      "description": "与旧右键riposte独立。成功完美格挡后4tick内实际左键可使一招伤害乘1.5；只有成功启动攻击才消费，失败输入保留机会。到期、死亡、换武器与强制中断清理。下一招不继承倍率。缺省兼容4tick/1.5倍。",
      "required": ["windowTicks", "damageMultiplier"],
      "properties": {
        "windowTicks": { "$ref": "#/$defs/ticks", "default": 4 },
        "damageMultiplier": { "type": "number", "minimum": 1, "maximum": 100, "default": 1.5 }
      }
    },
    "rapierTargetLock": {
      "type": "object", "additionalProperties": false,
      "description": "非spear拔刀状态先由准星明确选中目标，攻击被服务端接受后锁定，只维护已选目标，不自动搜索或抢选。R先解锁，再次R才收刀。距离为双方位置的三维格数，边界包含；保留range、allowPassive和视线参数，不自动锁玩家、盟友或宠物。旧JSON键保持rapierTargetLock以保留已有配置。",
      "required": ["enabled", "range", "allowPassive", "requireLineOfSight"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "range": { "type": "number", "minimum": 0.5, "maximum": 64, "default": 10 },
        "allowPassive": { "type": "boolean", "default": true },
        "requireLineOfSight": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "ticks": { "type": "integer", "minimum": 0, "maximum": 72000 },
    "resource": { "type": "number", "minimum": 0, "maximum": 1000000 },
    "angle": { "type": "number", "minimum": 0, "maximum": 360 }
  }
}
